{
  "header" :
  {
    "rule_set" : "SPM_RULES",
    "description" : "Erzeugt von SPM aus SPM_RULE und SPM_CONFIG (RULE_*). Nicht von Hand ändern."
  },
  "rules" :
  [
    {
      "id" : "SPM-RUN-FAILED",
      "_comment" : "Abruflauf fehlgeschlagen (Status -1)",
      "trigger_type" : "PROCESS_STOP",
      "action" : "SPM_POLL",
      "condition" :
      {
        "operator" : "STATUS_EQUALS",
        "value" : "-1"
      },
      "alert" :
      {
        "handler" : "SPM_ALERT",
        "severity" : "ERROR",
        "throttle_seconds" : 3600
      }
    },
    {
      "id" : "SPM-RUN-PARTIAL",
      "_comment" : "Abruflauf teilweise erfolgreich (Status 2)",
      "trigger_type" : "PROCESS_STOP",
      "action" : "SPM_POLL",
      "condition" :
      {
        "operator" : "STATUS_EQUALS",
        "value" : "2"
      },
      "alert" :
      {
        "handler" : "SPM_ALERT",
        "severity" : "WARN",
        "throttle_seconds" : 3600
      }
    },
    {
      "id" : "SPM-RUN-SLOW",
      "_comment" : "Abruflauf dauert zu lange (ms)",
      "trigger_type" : "PROCESS_STOP",
      "action" : "SPM_POLL",
      "condition" :
      {
        "operator" : "TIME_MAX_RUNTIME_EXCEEDED",
        "value" : "300000"
      },
      "alert" :
      {
        "handler" : "SPM_ALERT",
        "severity" : "WARN",
        "throttle_seconds" : 3600
      }
    },
    {
      "id" : "SPM-PROVIDER-SLOW",
