      {
        "operator" : "TIME_MAX_DURATION_MS",
        "value" : "10000"
      },
      "alert" :
      {
        "handler" : "SPM_ALERT",
        "severity" : "WARN",
        "throttle_seconds" : 3600
      }
    },
    {
      "id" : "SPM-POLL-FAILED",
